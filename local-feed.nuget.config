<?xml version="1.0" encoding="utf-8"?>
<!-- Installs the hippo tool from the local pack output. The package IDs are not reserved on nuget.org, so the mapping
     below takes them only from the local feed. nuget.org stays for everything else: installing a native tool package
     also fetches a Microsoft.NETCore.App.Host package. See the Distribution section of docs/dev/releasing.md. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="artifacts/nupkg" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="hippo" />
      <package pattern="hippo.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
