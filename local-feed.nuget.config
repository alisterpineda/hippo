<?xml version="1.0" encoding="utf-8"?>
<!-- Restricts a local install of the hippo tool to the local pack output. The package ID is not reserved on
     nuget.org, so that install must never consult it. See the Distribution section of README.md. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="artifacts/nupkg" />
  </packageSources>
</configuration>
