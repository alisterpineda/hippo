<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The version local builds and CI runs on main carry. A release passes the version its tag names in the
         HippoReleaseVersion environment variable, which .github/workflows/ci.yml sets from its `version` input, and
         that replaces this one in every build, pack and test of the run. -->
    <Version>0.1.0</Version>
    <Version Condition="'$(HippoReleaseVersion)' != ''">$(HippoReleaseVersion)</Version>
    <!-- Would append the full 40-character commit; src/Hippo/Hippo.csproj appends a short one instead. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
