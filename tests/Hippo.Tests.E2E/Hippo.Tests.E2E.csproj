<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The version the binary should print, since the tests cannot read it from hippo. -->
    <AssemblyMetadata Include="HippoVersion" Value="$(Version)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Builds hippo first, so its JIT launcher in src/Hippo/bin is current when HIPPO_EXE points at it. E2E must not
         call into hippo, and without the reference assembly the compiler enforces that. -->
    <ProjectReference Include="..\..\src\Hippo\Hippo.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Hippo.Tests.Shared\Hippo.Tests.Shared.csproj" />
  </ItemGroup>

  <!-- Publishes hippo as native AOT for this machine into aot/, which HippoProcess runs, so a local run tests what CI
       tests. Skipped when HIPPO_EXE names the binary to test. Its restore, which adds the runtime identifier, writes to
       its own folder: in hippo's obj it would replace the restore of every other build, and the build would go on
       reading the copy it loaded first. The runtime identifier is the portable one `dotnet publish` picks for this
       machine, since a distro-built SDK's own identifier has no runtime or ILCompiler packs on nuget.org.
       _IsPublishing is what `dotnet publish` sets, and the SDK keys native AOT settings on it, such as building no JIT
       apphost; the restore gets it too, so both evaluate hippo as `dotnet publish -r` would. The new
       MSBuildRestoreSessionId is what `msbuild -restore` passes, so the restore's evaluation of hippo is its own and
       no later call reuses it. -->
  <Target Name="PublishHippoAot" AfterTargets="Build" Condition="'$(HIPPO_EXE)' == ''">
    <PropertyGroup>
      <_HippoAotRestorePath>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'hippo-aot'))</_HippoAotRestorePath>
      <_HippoAotProperties>Configuration=$(Configuration);RuntimeIdentifier=$(NETCoreSdkPortableRuntimeIdentifier);_IsPublishing=true;MSBuildProjectExtensionsPath=$(_HippoAotRestorePath)</_HippoAotProperties>
    </PropertyGroup>
    <MSBuild Projects="..\..\src\Hippo\Hippo.csproj" Targets="Restore"
             Properties="$(_HippoAotProperties);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="..\..\src\Hippo\Hippo.csproj" Targets="Publish"
             Properties="$(_HippoAotProperties);PublishDir=$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)', 'aot'))" />
  </Target>

</Project>
