<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>hippo</AssemblyName>
    <RootNamespace>Hippo</RootNamespace>

    <!-- Trim, single-file and AOT analyzers; TreatWarningsAsErrors makes their warnings errors. -->
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The code LibraryImport generates for CanonicalPath's Windows calls is unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <PublishAot>true</PublishAot>
    <!-- Keeps the native debug symbols (.dSYM, .dbg, .pdb), several times the binary's size, out of the publish
         output and so out of the tool packages. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>

    <!-- A native AOT tool package per RID, packed on its own OS with `dotnet pack -r <rid>`, and a framework-dependent
         package for every other platform, packed with `dotnet pack -r any -p:PublishAot=false`. A plain `dotnet pack`
         makes the package users install, which lists the others. The native RIDs must match the `native` job's matrix in
         .github/workflows/ci.yml, which packs them, NATIVE_RIDS in .github/workflows/release.yml, which archives and
         pushes them, and the list in the Distribution section of docs/dev/releasing.md. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>hippo</ToolCommandName>
    <ToolPackageRuntimeIdentifiers>osx-arm64;osx-x64;linux-x64;linux-musl-x64;win-x64;any</ToolPackageRuntimeIdentifiers>
    <PackageId>hippo</PackageId>
    <Authors>Alister Pineda</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Indexes a markdown workspace into a local SQLite cache and answers structural questions about it.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/alisterpineda/hippo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/alisterpineda/hippo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>markdown;cli;index;links;search;okf;sqlite</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Dapper.AOT replaces Dapper's reflection with generated code through interceptors. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Dapper.AOT</InterceptorsNamespaces>
    <!-- DAP028 suggests AsList(), which lives on SqlMapper; its static constructor drags Dapper's reflection into the
         native AOT build. ToList() copies a list of rows instead. -->
    <NoWarn>$(NoWarn);DAP028</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Dapper.AOT" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exported from Hippo.Migrations by scripts/add-migration.sh; the migration runner applies them in order. -->
    <EmbeddedResource Include="Migrations/*.sql" LogicalName="Hippo.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hippo.Tests.Unit" />
    <InternalsVisibleTo Include="Hippo.Tests.Integration" />
  </ItemGroup>

  <!-- The version flag prints the informational version, and this adds the commit hippo was built from, shortened
       to 7 characters, as SemVer build metadata: 0.1.0-rc.1+d9d09f6. The SDK's own
       IncludeSourceRevisionInInformationalVersion stays off in Directory.Build.props, since it appends all 40;
       SourceRevisionId itself is left whole, as the package's repository commit uses it. A build outside a git
       repository has no commit and prints the bare version. -->
  <Target Name="AddShortCommitToInformationalVersion"
          BeforeTargets="GetAssemblyAttributes"
          DependsOnTargets="GetAssemblyVersion;InitializeSourceControlInformation"
          Condition="'$(SourceControlInformationFeatureSupported)' == 'true'">
    <PropertyGroup Condition="'$(SourceRevisionId)' != '' and !$(InformationalVersion.Contains('+'))">
      <InformationalVersion>$(InformationalVersion)+$(SourceRevisionId.Substring(0, 7))</InformationalVersion>
    </PropertyGroup>
  </Target>

  <!-- Links SQLite into the native AOT binary. -->
  <Import Project="Sqlite.targets" />

</Project>
