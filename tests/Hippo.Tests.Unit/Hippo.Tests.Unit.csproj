<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Dapper.AOT's analyzer flows in from Hippo; the tests use Dapper's reflection path, which runs under the JIT. -->
    <NoWarn>$(NoWarn);DAP005</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The install scripts as committed, for the test that the binary embeds them unchanged. -->
    <None Include="..\..\install.sh" Link="install.sh" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\install.ps1" Link="install.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hippo\Hippo.csproj" />
    <ProjectReference Include="..\..\src\Hippo.Migrations\Hippo.Migrations.csproj" />
    <ProjectReference Include="..\Hippo.Tests.Shared\Hippo.Tests.Shared.csproj" />
  </ItemGroup>

</Project>
